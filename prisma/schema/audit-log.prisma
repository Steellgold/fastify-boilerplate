model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  actorId    String?
  actorEmail String?
  actorRole  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
